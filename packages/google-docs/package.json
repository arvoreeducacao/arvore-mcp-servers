{
  "name": "@arvoretech/google-docs-mcp",
  "version": "1.0.0",
  "description": "Google Docs MCP Server — create, read, edit and export Google Docs documents via the Docs + Drive APIs",
  "main": "dist/lib.js",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "google-docs-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "mcp",
    "google-docs",
    "google-workspace",
    "docs",
    "documents",
    "oauth",
    "llm",
    "ai",
    "arvore"
  ],
  "author": "Arvore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arvoreeducacao/arvore-mcp-servers.git",
    "directory": "packages/google-docs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.22.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
