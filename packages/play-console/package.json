{
  "name": "@arvoretech/play-console-mcp",
  "version": "1.0.0",
  "description": "Google Play Console MCP Server — Android vitals (crash/ANR issues with stack traces, error counts, crash & ANR rates) and user reviews via a service account",
  "main": "dist/index.js",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "play-console-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "mcp",
    "google-play",
    "play-console",
    "android-vitals",
    "crashes",
    "anr",
    "reviews",
    "llm",
    "ai",
    "arvore"
  ],
  "author": "Arvore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arvoreeducacao/arvore-mcp-servers.git",
    "directory": "packages/play-console"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.22.0",
    "zod": "^3.22.4"
  }
}
